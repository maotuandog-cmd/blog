{
  "name": "dcp-wide",
  "description": "Wider sites: no fixed LEN/charset; VLM off; slightly softer evidence gate.",
  "ocr": {
    "mode": "auto",
    "minConf": 0.45,
    "softConf": 0.4,
    "len": null,
    "charset": null,
    "case": "lower",
    "morphWeight": 0.8,
    "beta": false,
    "agree": true,
    "agreeMin": 1.0,
    "agreeRelax": false
  },
  "vlm": {
    "mode": "off",
    "triggers": "t1",
    "policy": "abstain_on_conflict",
    "timeoutMs": 8000
  },
  "decision": {
    "minConf": 0.45,
    "softConf": 0.4,
    "decorrelate": true,
    "correlatedMinAgree": 1.0
  },
  "retry": {
    "maxAttempts": 2
  }
}
