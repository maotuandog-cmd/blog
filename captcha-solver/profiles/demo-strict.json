{
  "name": "demo-strict",
  "description": "captcha-demo: fixed length 6, restricted charset, case-insensitive verify.",
  "ocr": {
    "mode": "auto",
    "minConf": 0.5,
    "softConf": 0.45,
    "len": 6,
    "charset": "23456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ",
    "case": "lower",
    "morphWeight": 0.8,
    "beta": false,
    "agree": true,
    "agreeMin": 1.0,
    "agreeRelax": false,
    "charEvidence": true,
    "candidateMargin": true,
    "independentSource": true,
    "captchaTypeDetect": true
  },
  "vlm": {
    "mode": "auto",
    "triggers": "t1",
    "policy": "abstain_on_conflict",
    "timeoutMs": 8000
  },
  "decision": {
    "minConf": 0.5,
    "softConf": 0.45,
    "decorrelate": true,
    "correlatedMinAgree": 1.0,
    "singletonGate": false,
    "singletonMinEvidence": 0.65,
    "independentAgreeBonus": true,
    "agreeBonus": 0.1
  },
  "retry": {
    "maxAttempts": 2
  }
}
