# Hermes P0/P1 example env — copy to .env and fill secrets. Do not commit secrets.

HERMES_NODE_ID=hermes-1
HERMES_HTTP_ADDR=:8080
HERMES_REDIS_ADDR=127.0.0.1:6379
HERMES_REDIS_PASSWORD=
HERMES_STREAM_KEY=hermes:tasks
HERMES_DLQ_KEY=hermes:tasks:dlq
HERMES_CONSUMER_GROUP=hermes-workers
HERMES_LEASE_TTL_SEC=120
HERMES_CLAIM_MIN_IDLE_SEC=120
HERMES_TASK_TIMEOUT_SEC=600
HERMES_MAX_RETRIES=3
HERMES_BROWSER_WORKER_URL=http://127.0.0.1:8090
HERMES_BROWSER_MAX_COUNT=2

# Gateway auth (F-SEC-04): set token for production; local-only may set INSECURE=true
HERMES_API_TOKEN=change-me
HERMES_API_INSECURE=false

# Payload integrity (F-SEC-01): when set, require header X-Hermes-Signature: sha256=<hex>
HERMES_HMAC_SECRET=

# Timed scheduler (dispatcher)
HERMES_SCHED_INTERVAL_SEC=2

# Browser concurrency pools (F-SCHED-06 / F-BRW-05)
HERMES_BROWSER_MAX_COUNT=2
HERMES_BROWSER_AGENT_MAX_COUNT=1

# P1 agent
HERMES_BROWSER_AGENT_MAX_COUNT=1
HERMES_ALLOWED_HOSTS=example.com,httpbin.org
HERMES_DEFAULT_ANTI_DETECT=L3
HERMES_PROXY_URL=
# optional captcha webhook for L3
# mock (smoke-auth only): http://127.0.0.1:18084/captcha
# self-hosted solver:     http://127.0.0.1:18085/captcha
HERMES_CAPTCHA_WEBHOOK=
# captcha-solver OCR engine: auto (ddddocr then template) | ddddocr | template
HERMES_CAPTCHA_OCR=auto
# reject ddddocr text when vote confidence is below this (0–1)
HERMES_CAPTCHA_OCR_MIN_CONF=0.5

# Browser worker
HERMES_BROWSER_PORT=8090
HERMES_BROWSER_LOCALE=zh-CN
HERMES_BROWSER_HEADLESS=true

# P1 public-cloud LLM (OpenAI-compatible)
HERMES_LLM_API_KEY=
HERMES_LLM_BASE_URL=https://api.openai.com/v1
HERMES_LLM_MODEL=gpt-4o-mini
# T02 local acceptance without cloud key (browser-worker only)
HERMES_LLM_MOCK=false

# SSH host key (D08): prefer known_hosts in production
HERMES_SSH_KNOWN_HOSTS=
HERMES_SSH_INSECURE=true
